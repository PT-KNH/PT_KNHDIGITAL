function drawKpiChart(k){
  if (typeof Chart === 'undefined'){ $('kpiChartBox').innerHTML = '<p class="muted">โหลดกราฟไม่ได้ (ตรวจสอบอินเทอร์เน็ต)</p>'; return; }
  var ds = [{ label:'ผลงาน', data:k.months.map(function(v){ return v === '' ? null : v; }), borderColor:'#0ea5e9',
    backgroundColor:'rgba(14,165,233,.15)', fill:true, tension:.3, spanGaps:true, pointRadius:4 }];
  if (k.targetVal !== null && k.targetVal !== undefined && k.targetVal !== '')
    ds.push({ label:'เป้าหมาย (' + k.target + ')', data:FY_SHORT.map(function(){ return k.targetVal; }), borderColor:'#ef4444', borderDash:[6,4], pointRadius:0, fill:false });
  KPI_CHART = new Chart($('kpiChart'), { type:'line', data:{ labels:FY_SHORT, datasets:ds },
    options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom' } }, scales:{ y:{ beginAtZero:true } } } });
