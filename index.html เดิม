function pad(n){ return (n < 10 ? '0' : '') + n; }
function todayYmd(){ var t = new Date(); return t.getFullYear() + '-' + pad(t.getMonth()+1) + '-' + pad(t.getDate()); }
function ymdParts(s){
  var p = String(s || '').slice(0, 10).split('-').map(Number);
  if (p.length < 3 || p.some(isNaN)) return null;
  if (p[0] > 2400) p[0] -= 543;
  return p;
}
function thDate(s){
  var p = ymdParts(s);
  if (!p || p[1] < 1 || p[1] > 12) return s ? esc(s) : '-';
  return p[2] + ' ' + TH_M[p[1] - 1] + ' ' + (p[0] + 543);
}
function thDate2(s){
  var p = ymdParts(s);
  if (!p || p[1] < 1 || p[1] > 12) return s ? esc(s) : '-';
  return p[2] + ' ' + TH_M[p[1] - 1] + ' ' + (p[0] + 543) + ' (ค.ศ. ' + p[0] + ')';
}
function daysFromToday(s){
  var p = ymdParts(s); if (!p) return null;
  var t = new Date();
  return Math.round((Date.UTC(p[0], p[1] - 1, p[2]) - Date.UTC(t.getFullYear(), t.getMonth(), t.getDate())) / 86400000);
}
function daysTxt(d){
  return (d === null || d === undefined) ? '-' : d < 0 ? 'เกินมา ' + Math.abs(d) + ' วัน' : d === 0 ? 'หมดอายุวันนี้' : 'เหลือ ' + d + ' วัน';
}
