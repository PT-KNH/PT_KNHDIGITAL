  var d = { id:$('fId').value, fullName:$('fName').value.trim(), position:$('fPos').value, status:$('fStatus').value,
    licenseNo:$('fLic').value.trim(), licenseScore:$('fScore').value, licenseExpire:$('fExp').value,
    dob:$('fDob').value, startDate:$('fStart').value, phone:$('fPhone').value.trim(), email:$('fEmail').value.trim(),
    photoUrl:$('fPhotoUrl').value };
  if (!d.fullName) return toast('กรุณากรอกชื่อ-สกุล');
  spin(1);
  api('savePersonnel', TOKEN, d).then(function(r){
    spin(0); toast(r.msg);
    if (!r.ok) return;
    if (r.me){ ME = r.me; paintDock(ME); if ($('page-profile').classList.contains('on')) paintProfile(); }
    closeModal(true); loadPerson(); loadBoot();
  }).catch(fail);
}
function delPerson(id){
  var p = findPerson(id); if (!p) return;
  if (!confirm('ลบ "' + p.fullName + '" ?\nบัญชีผู้ใช้ที่ผูกกับบุคคลนี้จะถูกลบด้วย และกู้คืนไม่ได้')) return;
  spin(1);
  api('deletePersonnel', TOKEN, id).then(function(r){ spin(0); toast(r.msg); loadPerson(); loadBoot(); }).catch(fail);
}
function doUploadPhoto(){
  var inp = $('fPhoto'); if (!inp || !inp.files || !inp.files[0]) return;
  var f = inp.files[0];
  var pid = $('fId').value; if (!pid) return toast('กรุณาบันทึกข้อมูลก่อนอัปโหลดรูป');
  if (f.size > 15 * 1024 * 1024){ inp.value = ''; return toast('ไฟล์ใหญ่เกิน 15 MB'); }
  spin(1);
  var reader = new FileReader();
  reader.onerror = function(){ spin(0); inp.value = ''; toast('อ่านไฟล์ไม่สำเร็จ ลองเลือกไฟล์ใหม่อีกครั้ง'); };
  reader.onabort = reader.onerror;
  reader.onload = function(e){
    var img = new Image();
    img.onerror = function(){ spin(0); inp.value = ''; toast('อ่านไฟล์รูปนี้ไม่ได้ ลองใช้ไฟล์ JPG หรือ PNG'); };
    img.onload = function(){
      try {
        var w = img.width, h = img.height, max = 500;
        if (w > h && w > max){ h = Math.round(h * (max / w)); w = max; } else if (h > max){ w = Math.round(w * (max / h)); h = max; }
        var cv = document.createElement('canvas'); cv.width = w; cv.height = h;
        cv.getContext('2d').drawImage(img, 0, 0, w, h);
        var dataUrl = cv.toDataURL('image/jpeg', 0.82);
      } catch(err){ spin(0); inp.value = ''; return toast('ย่อขนาดรูปไม่สำเร็จ: ' + err.message); }
      api('uploadPhoto', TOKEN, pid, dataUrl).then(function(r){
        spin(0); toast(r.msg); inp.value = '';
        if (r.ok){ $('fPhotoUrl').value = r.url; $('pvPhoto').src = r.url; if (r.me){ ME = r.me; paintDock(ME); } }
      }).catch(function(err){ inp.value = ''; fail(err); });
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(f);
}

function loadUsers(){
  skel('userBody', 7, 4);
  api('listUsers', TOKEN).then(function(rows){
    USER_CACHE = rows || [];
    $('userBody').innerHTML = USER_CACHE.map(function(u){
      var id = esc(u.userId), acts = '';
      if (!u.isMe){
        acts += '<button class="btn sm ' + (u.active ? '' : 'ok') + '" onclick="uAct(\'' + id + '\',' + (!u.active) + ')">' + (u.active ? 'ปิดบัญชี' : '✔ อนุมัติ') + '</button> ';
        acts += '<button class="btn sm" onclick="uRole(\'' + id + '\')">' + (u.role === 'admin' ? 'ลดเป็นผู้ใช้' : 'ตั้งเป็น admin') + '</button> ';
      }
      acts += '<button class="btn sm" onclick="uReset(\'' + id + '\')">🔑 รีเซ็ตรหัส</button> ';
      acts += u.isMe ? '<span class="tag">บัญชีของคุณ</span>' : '<button class="btn sm danger" onclick="uDel(\'' + id + '\')">ลบ</button>';
      return '<tr><td><img class="avatar" src="' + esc(avatarOf(u.fullName, u.photoUrl)) + '"></td><td><b>' + esc(u.username) + '</b></td>' +
        '<td>' + esc(u.fullName) + '</td><td>' + esc(u.position) + '</td>' +
        '<td><span class="bg ' + (u.role === 'admin' ? 'blue' : 'gray') + '">' + (u.role === 'admin' ? 'ผู้ดูแลระบบ' : 'ผู้ใช้') + '</span></td>' +
        '<td><span class="bg ' + (u.active ? 'green' : u.pending ? 'amber' : 'gray') + '">' + (u.active ? 'ใช้งาน' : u.pending ? 'รออนุมัติ' : 'ปิดใช้งาน') + '</span></td><td><span>' + acts + '</span></td></tr>';
    }).join('') || '<tr><td colspan="7" class="ct muted">ไม่มีข้อมูล</td></tr>';
    labelize('userBody');
  }).catch(fail);
}
function findUser(id){ var u = null; USER_CACHE.forEach(function(x){ if (x.userId === id) u = x; }); return u; }
function userCall(fn, args, msg){
  if (msg && !confirm(msg)) return;
  spin(1);
  api.apply(null, [fn, TOKEN].concat(args)).then(function(r){ spin(0); toast(r.msg); loadUsers(); loadBoot(); }).catch(fail);
}
function uAct(id, on){ var u = findUser(id); userCall('setUserActive', [id, on], on ? null : 'ปิดบัญชี ' + (u ? u.username : '') + ' ? (ผู้ใช้จะถูกออกจากระบบทันที)'); }
function uRole(id){
  var u = findUser(id); if (!u) return;
  var to = u.role === 'admin' ? 'user' : 'admin';
  userCall('setUserRole', [id, to], (to === 'admin' ? 'ตั้ง ' : 'ลดสิทธิ์ ') + u.username + (to === 'admin' ? ' เป็นผู้ดูแลระบบ?' : ' เป็นผู้ใช้ทั่วไป?'));
}
function uReset(id){
  var u = findUser(id); if (!u) return;
  var pw = prompt('ตั้งรหัสผ่านใหม่ให้ ' + u.username + ' (อย่างน้อย 6 ตัว)');
  if (pw === null) return;
  if (pw.length < 6) return toast('รหัสผ่านอย่างน้อย 6 ตัว');
  userCall('resetUserPassword', [id, pw]);
}
function uDel(id){ var u = findUser(id); userCall('deleteUser', [id], 'ลบบัญชี ' + (u ? u.username : '') + ' ? (ข้อมูลบุคลากรยังคงอยู่)'); }

function loadLogs(){
  skel('logBody', 4, 8);
  api('listLogs', TOKEN, 500).then(function(rows){
    LOG_CACHE = rows || [];
    var acts = [], cur = $('lgAction').value;
    LOG_CACHE.forEach(function(l){ if (acts.indexOf(l.action) === -1) acts.push(l.action); });
    $('lgAction').innerHTML = '<option value="">ทุกประเภท</option>' + acts.map(function(a){
      return '<option value="' + esc(a) + '"' + (a === cur ? ' selected' : '') + '>' + esc(LOG_LABEL[a] || a) + '</option>'; }).join('');
    renderLogs();
  }).catch(fail);
}
function renderLogs(){
  var q = ($('lgSearch').value || '').toLowerCase(), a = $('lgAction').value;
  $('logBody').innerHTML = LOG_CACHE.filter(function(l){
    return (!a || l.action === a) && (!q || (l.user + ' ' + l.detail).toLowerCase().indexOf(q) > -1);
  }).map(function(l){
    var c = (l.action === 'LOGIN_FAIL' || l.action === 'DELETE' || l.action === 'CLIENT_ERR') ? 'red' : l.action === 'AI' ? 'purple' :
            (l.action === 'LINE' || l.action === 'EMAIL' || l.action === 'REPORT' || l.action === 'BACKUP') ? 'blue' : 'gray';
    return '<tr><td>' + thDateTime(l.at) + '</td><td>' + esc(l.user) + '</td><td><span class="bg ' + c + '">' + esc(LOG_LABEL[l.action] || l.action) +
      '</span></td><td><span>' + esc(l.detail) + '</span></td></tr>';
  }).join('') || '<tr><td colspan="4" class="ct muted">ไม่มีข้อมูล</td></tr>';
  labelize('logBody');
}

function okBadge(ok, yes, no){ return '<span class="bg ' + (ok ? 'green' : 'gray') + '" style="margin-left:6px">' + (ok ? yes : no) + '</span>'; }
function loadSettings(){
  spin(1);
  api('getSettings', TOKEN).then(function(s){
    spin(0);
    $('sLineToken').value = ''; $('sLineToken').placeholder = s.lineToken ? '••••• ตั้งค่าแล้ว (เว้นว่าง = ไม่เปลี่ยน)' : 'วาง Channel access token';
    $('sGroupId').value = s.lineGroupId || '';
    $('sHideLic').checked = !!s.hideLicense;
    $('sGemini').value = ''; $('sGemini').placeholder = s.geminiKey ? '••••• ตั้งค่าแล้ว (เว้นว่าง = ไม่เปลี่ยน)' : 'วาง API Key';
    $('sEmails').value = s.reportEmails || '';
    $('sTarget').value = s.ptceuTarget;
    $('sFrontendUrl').value = s.frontendUrl || '';
    $('webhookUrl').textContent = s.webAppUrl || '-';
    $('stLine').innerHTML = s.lineEnabled
      ? okBadge(s.lineToken && s.lineGroupId, 'พร้อมใช้งาน', s.lineToken ? 'รอ Group ID' : 'ยังไม่ตั้งค่า')
      : '<span class="bg gray" style="margin-left:6px">ปิดอยู่</span>';
    $('stGemini').innerHTML = okBadge(s.geminiKey, 'พร้อมใช้งาน', 'ยังไม่ตั้งค่า');
    $('stQuota').textContent = s.mailQuota !== null && s.mailQuota !== undefined ? 'โควตาอีเมลคงเหลือวันนี้: ' + s.mailQuota : '';
    var tr = s.triggers || [];
    $('stTrig').innerHTML = tr.length ? tr.map(function(t){ return '<span class="tag">✅ ' + esc(TRIG_LABEL[t] || t) + '</span>'; }).join('')
      : '<span class="bg amber">ยังไม่ได้ติดตั้งงานอัตโนมัติ</span>';
    var jobs = s.jobs || [];
    $('stJobs').innerHTML = jobs.length ? jobs.map(function(j){
      var st = j.ok === null ? '<span class="bg gray">ยังไม่เคยรัน</span>'
             : j.ok ? '<span class="bg green">สำเร็จ</span>' : '<span class="bg red">ล้มเหลว</span>';
      return '<div class="job-row"><span>' + esc(TRIG_LABEL[j.name] || j.name) + '</span>' + st + '</div>' +
        (j.at ? '<div class="job-sub">' + thDateTime(j.at) + (j.ok === false ? ' — ' + esc(j.msg) : '') + '</div>' : '');
    }).join('') : '<p class="muted">ยังไม่มีข้อมูล</p>';
    $('stBackup').textContent = s.backupFolderId ? 'โฟลเดอร์สำรองข้อมูลใน Google Drive: PT_BACKUP (เก็บ 12 ชุดล่าสุด) · Log เก่ากว่า 6 เดือนจะถูกย้ายไปชีต LOG_ARCHIVE อัตโนมัติ' : 'จะสร้างโฟลเดอร์ PT_BACKUP อัตโนมัติเมื่อสำรองครั้งแรก';
  }).catch(fail);
}
function saveSettingsForm(){
  var d = { lineToken:$('sLineToken').value.trim(), lineGroupId:$('sGroupId').value.trim(), hideLicense:$('sHideLic').checked,
    geminiKey:$('sGemini').value.trim(), reportEmails:$('sEmails').value.trim(), ptceuTarget:$('sTarget').value,
    frontendUrl:$('sFrontendUrl').value.trim() };
  spin(1);
  api('saveSettings', TOKEN, d).then(function(r){ spin(0); toast(r.msg); if (r.ok){ loadSettings(); loadBoot(); } }).catch(fail);
}
function copyWebhook(){ copyText($('webhookUrl').textContent, 'คัดลอก Webhook URL แล้ว'); }

function setModDirty(on){ MOD_DIRTY = !!on; var b = $('modSaveBar'); if (b) b.classList.toggle('hide', !on); }
function renderModTable(){
  $('modBody').innerHTML = MOD_CACHE.map(function(m, i){
    var id = esc(m.id);
    return '<tr><td class="ct"><b>' + (i + 1) + '</b></td><td style="font-size:1.3rem">' + esc(m.icon) + '</td><td><b style="border-left:4px solid ' + esc(m.color) + ';padding-left:6px">' + esc(m.name) + '</b></td>' +
      '<td>' + esc(m.subtitle) + '</td><td><small style="word-break:break-all">' + esc(m.url) + '</small></td>' +
      '<td><span class="bg ' + (m.active ? 'green' : 'gray') + '">' + (m.active ? 'เปิด' : 'ปิด') + '</span></td><td><span>' +
      '<button class="btn sm" ' + (i === 0 ? 'disabled' : '') + ' onclick="mMove(' + i + ',\'up\')">↑</button> ' +
      '<button class="btn sm" ' + (i === MOD_CACHE.length - 1 ? 'disabled' : '') + ' onclick="mMove(' + i + ',\'down\')">↓</button> ' +
      '<button class="btn sm" onclick="openModForm(\'' + id + '\')">แก้ไข</button> <button class="btn sm danger" onclick="mDel(\'' + id + '\')">ลบ</button></span></td></tr>';
  }).join('') || '<tr><td colspan="7" class="ct muted">ไม่มีข้อมูล</td></tr>';
  labelize('modBody');
}
function loadMods(){
  skel('modBody', 7, 4);
  api('listModules', TOKEN).then(function(rows){ MOD_CACHE = rows || []; setModDirty(false); renderModTable(); }).catch(fail);
}
function findMod(id){ var m = null; MOD_CACHE.forEach(function(x){ if (x.id === id) m = x; }); return m; }
function openModForm(id){
  if (MOD_DIRTY) return toast('กรุณากด "บันทึกลำดับ" หรือ "ยกเลิก" ก่อน');
  var m = id ? findMod(id) : null, cur = m ? m.icon : '📁';
  var curPos = 1;
  MOD_CACHE.forEach(function(x, k){ if (m && x.id === m.id) curPos = k + 1; });
  if (!m) curPos = MOD_CACHE.length + 1;
  var grid = ICON_SET.map(function(ic){ return '<div class="icon-opt" onclick="pickIcon(this)">' + ic + '</div>'; }).join('');
  var body = fld('ไอคอน', '<div class="icon-row"><div class="icon-preview" id="mIconPreview">' + esc(cur) + '</div><input type="hidden" id="mIcon" value="' + esc(cur) + '">' +
      '<small class="muted">แตะเลือกด้านล่าง</small></div><div class="icon-grid">' + grid + '</div>') +
    fld('ชื่อโมดูล *', '<input id="mName" maxlength="60" value="' + esc(m ? m.name : '') + '">') +
    fld('คำอธิบาย', '<input id="mSub" maxlength="120" value="' + esc(m ? m.subtitle : '') + '">') +
    fld('ลิงก์ * (#kpi สำหรับหน้าในระบบ หรือ https://...)', '<input id="mUrl" value="' + esc(m ? m.url : '') + '" autocapitalize="none">') +
    fld('ลำดับที่แสดงในเมนู (1 = บนสุด · ทั้งหมด ' + (m ? MOD_CACHE.length : MOD_CACHE.length + 1) + ' รายการ)',
        '<input id="mOrder" type="number" inputmode="numeric" min="1" max="' + (m ? MOD_CACHE.length : MOD_CACHE.length + 1) + '" step="1" value="' + curPos + '">') +
    '<div class="grid2">' + fld('สีแถบ', '<input id="mColor" type="color" value="' + esc(m ? m.color : '#0ea5e9') + '" style="height:40px;padding:2px">') +
    '<div class="fld"><label>&nbsp;</label><label class="chk"><input type="checkbox" id="mActive"' + (!m || m.active ? ' checked' : '') + '> แสดงในเมนู</label></div></div>';
  openModal(m ? 'แก้ไขโมดูล' : 'เพิ่มโมดูล', body,
    '<button class="btn" onclick="closeModal()">ยกเลิก</button><button class="btn primary" onclick="saveMod(\'' + (m ? esc(m.id) : '') + '\')">บันทึก</button>');
}
function pickIcon(el){ $('mIcon').value = el.textContent; $('mIconPreview').textContent = el.textContent; FORM_DIRTY = true; }
function saveMod(id){
  var d = { id:id, name:$('mName').value.trim(), subtitle:$('mSub').value.trim(), url:$('mUrl').value.trim(),
    icon:$('mIcon').value, color:$('mColor').value, active:$('mActive').checked, order:$('mOrder').value };
  if (!d.name || !d.url) return toast('กรอกชื่อและลิงก์ให้ครบ');
  if (!/^#[a-z]+$/i.test(d.url) && !/^https:\/\//i.test(d.url)) return toast('ลิงก์ต้องขึ้นต้นด้วย # หรือ https:// เท่านั้น');
  spin(1);
  api('saveModule', TOKEN, d).then(function(r){ spin(0); toast(r.msg); if (r.ok){ closeModal(true); loadMods(); loadBoot(); } }).catch(fail);
}
function mMove(i, dir){
  i = Number(i);
  var j = i + (dir === 'up' ? -1 : 1);
  if (i < 0 || j < 0 || j >= MOD_CACHE.length) return;
  var t = MOD_CACHE[i]; MOD_CACHE[i] = MOD_CACHE[j]; MOD_CACHE[j] = t;
  setModDirty(true);
  renderModTable();
  renderSidebarMods(MOD_CACHE.filter(function(m){ return m.active && m.url; }));
}
function saveModOrder(){
  if (!MOD_DIRTY) return;
  spin(1);
  api('saveModuleOrder', TOKEN, MOD_CACHE.map(function(m){ return m.id; })).then(function(r){
    spin(0);
    if (!r || !r.ok) return toast((r && r.msg) || 'บันทึกลำดับไม่สำเร็จ');
    toast(r.msg || 'บันทึกลำดับเรียบร้อย');
    localStorage.removeItem('pt_boot_cache');
    setModDirty(false);
    loadMods(); loadBoot();
  }).catch(fail);
}
function cancelModOrder(){
  setModDirty(false);
  loadMods();
  if (BOOT) renderSidebarMods(BOOT.modules);
}
function mDel(id){
  if (MOD_DIRTY) return toast('กรุณากด "บันทึกลำดับ" หรือ "ยกเลิก" ก่อน');
  var m = findMod(id); if (!m || !confirm('ลบโมดูล "' + m.name + '" ?')) return;
  spin(1); api('deleteModule', TOKEN, id).then(function(r){ spin(0); toast(r.msg); loadMods(); loadBoot(); }).catch(fail);
}
</script>
