<!DOCTYPE html>
<html lang="th">
<head>
<base target="_top">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#f9f9fb">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="apple-touch-icon" href="https://em-content.zobj.net/source/apple/391/hospital_1f3e5.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="PT Center">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Sarabun','Segoe UI',Tahoma,sans-serif;background:#f1f5f9;color:#0f172a;font-size:14px;line-height:1.5;-webkit-tap-highlight-color:transparent}
.hide{display:none!important}
a{text-decoration:none;color:inherit}
button{font-family:inherit;cursor:pointer}
.btn{border:none;border-radius:8px;padding:8px 14px;background:#e2e8f0;color:#0f172a;font-size:.86rem;font-weight:500;transition:.15s}
.btn:hover:not(:disabled){filter:brightness(.95)}
.btn:disabled{opacity:.55;cursor:not-allowed}
.btn.primary{background:#0ea5e9;color:#fff}
.btn.danger{background:#ef4444;color:#fff}
.btn.ok{background:#10b981;color:#fff}
.btn.line{background:#06c755;color:#fff}
.btn.ai{background:#8b5cf6;color:#fff}
.btn.sm{padding:4px 9px;font-size:.76rem}
input,select,textarea{font-family:inherit;font-size:.9rem;padding:8px 10px;border:1px solid #cbd5e1;border-radius:8px;width:100%;background:#fff;color:inherit}
input:focus,select:focus,textarea:focus{outline:none;border-color:#0ea5e9;box-shadow:0 0 0 3px rgba(14,165,233,.15)}
input:disabled,select:disabled,textarea:disabled{background:#f1f5f9;color:#64748b}
label{font-size:.82rem;color:#475569;display:block;margin-bottom:3px;font-weight:500}

#loginWrap{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0ea5e9,#6366f1);padding:20px}
.lg-card{background:#fff;border-radius:18px;padding:30px;width:100%;max-width:420px;box-shadow:0 20px 50px rgba(0,0,0,.25)}
.lg-card h1{font-size:1.3rem;text-align:center;margin-bottom:4px}
.lg-card p.sub{text-align:center;color:#64748b;font-size:.85rem;margin-bottom:18px}
.msg{padding:9px 12px;border-radius:8px;font-size:.85rem;margin-bottom:12px}
.msg.err{background:#fee2e2;color:#b91c1c}
.msg.ok{background:#d1fae5;color:#065f46}

#mobHeader{display:none}
#tabBar{display:none}
#sideMask{display:none}

#app{display:flex;min-height:100vh}
#side{width:240px;background:#0f172a;color:#cbd5e1;padding:16px 12px;flex:none;position:sticky;top:0;height:100vh;overflow:auto;display:flex;flex-direction:column;z-index:940}
#side .logo{color:#fff;font-weight:700;font-size:1.02rem;padding:6px 8px 14px;line-height:1.4}
#side .logo small{display:block;font-weight:400;font-size:.72rem;color:#64748b}
.nav-item,.nav-mod{display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:8px;margin-bottom:3px;cursor:pointer;font-size:.88rem;transition:.15s;position:relative}
.nav-item:hover,.nav-mod:hover{background:#1e293b;color:#fff}
.nav-item.active{background:#0ea5e9;color:#fff;font-weight:600}
.nav-mod{border-left:3px solid #0ea5e9;background:#111c30}
.nav-sep{height:1px;background:#1e293b;margin:12px 4px}
.nav-cap{font-size:.68rem;color:#475569;padding:4px 10px;letter-spacing:.5px}
.nav-ico{width:20px;text-align:center}
.nav-badge{position:absolute;right:10px;background:#ef4444;color:#fff;font-size:.68rem;font-weight:700;padding:1px 7px;border-radius:20px;line-height:1.5}
.side-foot{margin-top:auto;padding:10px 8px;border-top:1px solid #1e293b;font-size:.68rem;color:#64748b;line-height:1.6}
.side-foot b{color:#94a3b8}
main{flex:1;padding:20px 24px 90px;overflow:auto;min-width:0}
.page{display:none}.page.on{display:block}
.page-head{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:16px}
.page-head h2{font-size:1.18rem}
.head-tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.head-tools select{width:auto;min-width:150px}
h3.sec{margin:20px 0 10px;font-size:1rem}
#greet{margin:-8px 0 12px;color:#64748b;font-size:.88rem}

.smart-banner{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.smart-chip{display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border-radius:10px;font-size:.83rem;background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.06);border-left:4px solid #0ea5e9;cursor:pointer;transition:.15s}
.smart-chip:hover{transform:translateY(-1px);box-shadow:0 4px 10px rgba(0,0,0,.1)}
.smart-chip.warn{border-left-color:#f59e0b;background:#fffbeb}
.smart-chip.danger{border-left-color:#ef4444;background:#fef2f2}
.smart-chip.ok{border-left-color:#10b981;background:#ecfdf5}

.filter-bar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:12px}
.pills{display:flex;gap:6px;flex-wrap:wrap}
.pill{border:1px solid #cbd5e1;background:#fff;color:#475569;border-radius:20px;padding:5px 12px;font-size:.8rem;cursor:pointer;transition:.15s;white-space:nowrap}
.pill:hover{border-color:#0ea5e9;color:#0ea5e9}
.pill.on{background:#0ea5e9;color:#fff;border-color:#0ea5e9;font-weight:600}

.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:12px}
.stat{background:#fff;border-radius:12px;padding:13px 15px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.stat .t{font-size:.78rem;color:#64748b}
.stat .n{font-size:1.55rem;font-weight:700;line-height:1.3}
.stat small{font-size:.72rem;color:#94a3b8}
.stat.click{cursor:pointer}.stat.click:hover{transform:translateY(-2px);transition:.2s}
.panel{background:#fff;border-radius:12px;padding:14px 16px;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.panel h4{margin-bottom:8px}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}
.table-wrap{background:#fff;border-radius:12px;overflow:auto;box-shadow:0 2px 8px rgba(0,0,0,.06)}
table.tbl{width:100%;border-collapse:collapse;font-size:.85rem;min-width:760px}
table.tbl.sm{min-width:0}
table.tbl th{background:#f8fafc;text-align:left;padding:9px 10px;border-bottom:2px solid #e2e8f0;position:sticky;top:0;font-size:.8rem;white-space:nowrap}
table.tbl td{padding:8px 10px;border-bottom:1px solid #f1f5f9;vertical-align:middle}
table.tbl tr.grp td{background:#e0f2fe;font-weight:700;color:#075985}
.rt{text-align:right}.ct{text-align:center}.muted{color:#94a3b8}
.avatar{width:36px;height:36px;border-radius:50%;object-fit:cover;background:#e2e8f0}
.bg{padding:2px 8px;border-radius:20px;font-size:.72rem;color:#fff;display:inline-block;white-space:nowrap}
.bg.green{background:#10b981}.bg.red{background:#ef4444}.bg.gray{background:#94a3b8}
.bg.blue{background:#0ea5e9}.bg.amber{background:#f59e0b}.bg.purple{background:#8b5cf6}
.trend{display:inline-block;font-size:.7rem;font-weight:600;padding:1px 6px;border-radius:6px;margin-left:4px;white-space:nowrap}
.trend.good{background:#d1fae5;color:#065f46}
.trend.bad{background:#fee2e2;color:#b91c1c}
.trend.neutral{background:#f1f5f9;color:#475569}
.bar{background:#eef2f7;border-radius:6px;height:8px;overflow:hidden;min-width:60px}
.bar i{display:block;height:100%;border-radius:6px}
.kpi-row{display:grid;grid-template-columns:1fr 105px 58px;gap:10px;align-items:center;padding:7px 0;border-bottom:1px solid #f1f5f9;font-size:.85rem}
.kpi-row span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.kpi-row.alert span{color:#b91c1c}
.score{display:flex;align-items:center;gap:6px;min-width:120px}
.score .bar{flex:1}
.score b{font-size:.75rem;white-space:nowrap}
.tag{display:inline-block;padding:2px 8px;border-radius:6px;font-size:.72rem;background:#f1f5f9;color:#334155;margin:2px}

.skel{height:12px;border-radius:6px;background:linear-gradient(90deg,#eef2f7 25%,#e2e8f0 37%,#eef2f7 63%);background-size:400% 100%;animation:sk 1.3s ease infinite}
@keyframes sk{0%{background-position:100% 50%}100%{background-position:0 50%}}

.ai-box{border-left:4px solid #8b5cf6;margin-top:14px;background:linear-gradient(135deg,#faf5ff,#fff)}
.ai-h{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px}
.ai-t{line-height:1.85;font-size:.88rem;margin-bottom:6px}

.sec-t{font-size:.8rem;font-weight:700;color:#0369a1;margin:8px 0 8px;padding-bottom:4px;border-bottom:1px dashed #e2e8f0}
.set-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.hint{font-size:.75rem;color:#64748b;margin:-4px 0 10px;line-height:1.55}
.btn-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.chk{display:flex;align-items:center;gap:8px;font-size:.84rem;margin-bottom:10px;color:#334155}
.chk input{width:auto}
.m-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.m-grid label{font-size:.72rem}
.chart-box{height:250px;margin-bottom:12px}
code.url{display:block;background:#f1f5f9;padding:8px;border-radius:8px;font-size:.72rem;word-break:break-all;margin-bottom:8px}
.job-row{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #f1f5f9;font-size:.84rem}
.job-sub{font-size:.72rem;color:#64748b;margin:-4px 0 8px;line-height:1.5}
.date-dual{font-size:.76rem;color:#0369a1;margin-top:4px;line-height:1.45}
.date-dual.warn{color:#b45309}.date-dual.danger{color:#b91c1c;font-weight:600}

#mask{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;z-index:1000;align-items:center;justify-content:center;padding:16px}
#mask.on{display:flex}
.modal{background:#fff;border-radius:14px;width:100%;max-width:640px;max-height:90vh;overflow:auto}
.modal.wide{max-width:860px}
.modal-h{padding:14px 18px;border-bottom:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;gap:10px;position:sticky;top:0;background:#fff;z-index:2}
.modal-h b{font-size:.98rem}
.modal-b{padding:16px 18px}
.modal-f{padding:12px 18px;border-top:1px solid #e2e8f0;display:flex;justify-content:flex-end;gap:8px;position:sticky;bottom:0;background:#fff}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.fld{margin-bottom:11px}
.pv-photo{width:110px;height:110px;border-radius:12px;object-fit:cover;background:#e2e8f0;display:block;margin:6px 0}

.icon-row{display:flex;gap:10px;align-items:center}
.icon-preview{width:44px;height:44px;border-radius:10px;background:#f1f5f9;border:1.5px solid #cbd5e1;display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex:none}
.icon-grid{display:grid;grid-template-columns:repeat(10,1fr);gap:6px;padding:8px;background:#f8fafc;border-radius:10px;margin-top:8px}
.icon-opt{font-size:1.25rem;text-align:center;padding:5px 0;border-radius:8px;cursor:pointer;background:#fff;border:1px solid #e2e8f0}
.icon-opt:hover{background:#e0f2fe;border-color:#0ea5e9}

.user-dock{position:fixed;right:18px;bottom:18px;z-index:900;background:#fff;border-radius:50px;box-shadow:0 8px 26px rgba(0,0,0,.2);padding:6px 16px 6px 6px;display:flex;align-items:center;gap:10px;cursor:pointer;transition:.22s;max-width:250px}
.user-dock.open{border-radius:16px;padding:16px;flex-direction:column;align-items:stretch;width:270px;max-width:90vw}
.dock-avatar{width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid #0ea5e9;background:#e2e8f0;flex:none}
.user-dock.open .dock-avatar{width:86px;height:86px;align-self:center;margin-bottom:8px}
.dock-name{font-weight:600;font-size:.87rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-dock.open .dock-name{display:none}
.dock-detail{display:none;font-size:.84rem;line-height:1.85}
.user-dock.open .dock-detail{display:block}
.dk-h{text-align:center;font-weight:700;font-size:1rem}
.dk-s{text-align:center;color:#64748b;margin-bottom:8px;font-size:.82rem}

#toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:#0f172a;color:#fff;padding:10px 20px;border-radius:30px;font-size:.86rem;z-index:1300;display:none;box-shadow:0 8px 20px rgba(0,0,0,.3);max-width:90vw;text-align:center}
#spin{position:fixed;inset:0;background:rgba(255,255,255,.6);z-index:1200;display:none;align-items:center;justify-content:center;font-weight:600;color:#0ea5e9}
#spin.on{display:flex}

/* ================= MOBILE — iOS STYLE (≤860px) ================= */
@media(max-width:860px){
  body{background:#f2f2f7;color:#000;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Sarabun','Segoe UI',sans-serif;font-size:15px}
  input,select,textarea{font-size:16px;border-radius:10px;border-color:#d1d1d6;padding:10px 12px}
  .btn{border-radius:10px;min-height:40px;font-size:.9rem;font-weight:600}
  .btn.sm{min-height:34px;font-size:.8rem;border-radius:8px}
  .btn.primary{background:#007aff}
  .btn.danger{background:#ff3b30}
  .btn.ok{background:#34c759}
  .btn:not(.primary):not(.danger):not(.ok):not(.line):not(.ai){background:#e9e9ee;color:#007aff}

  #mobHeader{display:flex;align-items:center;justify-content:space-between;gap:10px;position:sticky;top:0;z-index:950;
    background:rgba(249,249,251,.86);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);
    border-bottom:.5px solid rgba(60,60,67,.29);padding:calc(8px + env(safe-area-inset-top)) 12px 8px}
  #mobHeader .m-btn{background:none;border:0;color:#007aff;font-size:22px;min-width:40px;min-height:40px;text-align:left}
  #mobHeader .m-brand{font-size:17px;font-weight:600;flex:1;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #mobHeader .m-av{width:32px;height:32px;border-radius:50%;object-fit:cover;background:#e5e5ea;cursor:pointer}

  #app{flex-direction:column}
  #side{position:fixed;top:0;bottom:0;left:0;width:82%;max-width:320px;height:100%;z-index:990;
    transform:translateX(-102%);transition:transform .25s ease;padding-top:calc(16px + env(safe-area-inset-top));
    padding-bottom:calc(16px + env(safe-area-inset-bottom))}
  #side.mob-open{transform:none;box-shadow:0 0 40px rgba(0,0,0,.35)}
  #sideMask.on{display:block;position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:985}

  main{padding:8px 16px calc(100px + env(safe-area-inset-bottom))}
  .page-head{flex-direction:column;align-items:stretch;gap:10px;margin:6px 0 14px}
  .page-head h2{font-size:30px;font-weight:700;letter-spacing:-.5px}
  .head-tools{gap:8px}
  .head-tools > *{flex:1 1 auto}
  .head-tools input,.head-tools select{width:100%!important;min-width:0}
  #greet{margin:-6px 0 12px;color:#8e8e93}

  .two-col,.grid2,.grid3,.set-grid{grid-template-columns:1fr}
  .m-grid{grid-template-columns:repeat(3,1fr)}
  .stats-grid{grid-template-columns:repeat(2,1fr);gap:10px}
  .stat,.panel{border-radius:14px;box-shadow:none;border-top-width:0!important}
  .stat .n{font-size:1.6rem}
  .smart-chip{width:100%;border-radius:14px;box-shadow:none;border-left-width:5px}
  .pills{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:2px;width:100%}
  .pill{padding:7px 14px;font-size:.85rem}
  .pill.on{background:#007aff;border-color:#007aff}
  #kSearch,#pSearch,#lgSearch{width:100%!important}
  .filter-bar{flex-direction:column;align-items:stretch}

  .user-dock{display:none!important}

  #tabBar{display:grid;grid-template-columns:repeat(5,1fr);position:fixed;left:0;right:0;bottom:0;z-index:960;
    background:rgba(249,249,251,.92);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);
    border-top:.5px solid rgba(60,60,67,.29);padding:6px 0 calc(6px + env(safe-area-inset-bottom))}
  #tabBar button{background:none;border:0;color:#8e8e93;font-size:10px;font-weight:500;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:2px;min-height:48px;position:relative}
  #tabBar button .ti{font-size:22px;line-height:1;filter:grayscale(1);opacity:.65}
  #tabBar button.on{color:#007aff}
  #tabBar button.on .ti{filter:none;opacity:1}
  #tabBar .tb-badge{position:absolute;top:2px;left:calc(50% + 6px);background:#ff3b30;color:#fff;font-size:10px;font-weight:700;
    min-width:18px;height:18px;line-height:18px;border-radius:9px;padding:0 5px}

  #toast{bottom:calc(92px + env(safe-area-inset-bottom));border-radius:14px}

  #mask{align-items:flex-end;padding:0}
  .modal,.modal.wide{max-width:100%;border-radius:14px 14px 0 0;max-height:92vh}
  .modal-h{padding:14px 16px}
  .modal-b{padding:14px 16px}
  .modal-f{padding:10px 16px calc(12px + env(safe-area-inset-bottom))}
  .modal-f .btn{flex:1}
  .icon-grid{grid-template-columns:repeat(6,1fr)}

  .table-wrap{background:transparent;box-shadow:none;overflow:visible;border-radius:0}
  table.tbl:not(.sm){min-width:0}
  table.tbl:not(.sm) thead{display:none}
  table.tbl:not(.sm) tbody tr{display:block;background:#fff;border-radius:14px;margin-bottom:10px;padding:4px 14px}
  table.tbl:not(.sm) tbody td{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px 12px;
    border-bottom:.5px solid #e5e5ea;padding:10px 0;text-align:right}
  table.tbl:not(.sm) tbody td:last-child{border-bottom:0}
  table.tbl:not(.sm) tbody td::before{content:attr(data-label);color:#8e8e93;font-size:13px;text-align:left;flex:none;max-width:45%}
  table.tbl:not(.sm) tbody td[data-label=""]::before{display:none}
  table.tbl:not(.sm) tbody td[data-label=""]{justify-content:flex-start}
  table.tbl:not(.sm) tbody td[colspan]{justify-content:center;text-align:center}
  table.tbl:not(.sm) tbody tr.grp{background:none;padding:14px 4px 6px;margin:0}
  table.tbl:not(.sm) tbody tr.grp td{background:none;color:#6d6d72;font-size:13px;font-weight:600;border:0;padding:0;justify-content:flex-start;text-align:left}
  table.tbl:not(.sm) .score{min-width:0;width:58%}
  table.tbl:not(.sm) .bar{flex:1}
}
</style>
</head>
<body>

<div id="loginWrap">
  <div class="lg-card">
    <h1>🏥 PT Digital Center</h1>
    <p class="sub">หน่วยกายภาพบำบัด โรงพยาบาลเขื่องใน</p>
    <div id="lgMsg"></div>
    <div id="paneLogin">
      <div class="fld"><label>ชื่อผู้ใช้</label><input id="luser" autocomplete="username" autocapitalize="none" onkeydown="if(event.key=='Enter')doLogin()"></div>
      <div class="fld"><label>รหัสผ่าน</label><input id="lpass" type="password" autocomplete="current-password" onkeydown="if(event.key=='Enter')doLogin()"></div>
      <button class="btn primary" style="width:100%" onclick="doLogin()">เข้าสู่ระบบ</button>
      <p style="text-align:center;margin-top:12px;font-size:.85rem">
        ยังไม่มีบัญชี? <a href="javascript:void(0)" onclick="togglePane(1)" style="color:#0ea5e9">ลงทะเบียน</a></p>
      <div id="apiCfgBox" class="hide" style="margin-top:14px;padding-top:12px;border-top:1px dashed #e2e8f0">
        <label style="font-size:.76rem;color:#0369a1">🔗 ตั้งค่าลิงก์ API (สำหรับโหมด GitHub Pages)</label>
        <div style="display:flex;gap:6px;margin-top:4px">
          <input id="cfgGasUrl" placeholder="วางลิงก์ https://script.google.com/.../exec" style="font-size:.78rem;padding:6px 8px">
          <button class="btn sm primary" onclick="saveGasUrlBtn()">บันทึก</button>
        </div>
      </div>
    </div>
    <div id="paneReg" class="hide">
