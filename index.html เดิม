function loadBoot(){
  var cached = localStorage.getItem('pt_boot_cache'), used = false;
  if (cached){
    try {
      var d0 = JSON.parse(cached);
      if (ME && d0.owner === ME.userId){ d0.me = ME; applyBoot(d0); used = true; }
      else localStorage.removeItem('pt_boot_cache');
    } catch(e){ localStorage.removeItem('pt_boot_cache'); }
  }
  if (!used) spin(1);
  api('getBootstrap', TOKEN).then(function(d){
    spin(0); applyBoot(d);
    var s = JSON.parse(JSON.stringify(d)); delete s.me; s.owner = ME.userId;
    try { localStorage.setItem('pt_boot_cache', JSON.stringify(s)); } catch(e){}
    if (d.version && d.version !== CLIENT_VERSION && !window._verWarned){
      window._verWarned = true;
      toast('⚠️ หน้าเว็บ ' + CLIENT_VERSION + ' ไม่ตรงกับเซิร์ฟเวอร์ ' + d.version + ' — อัปเดต index.html ให้ตรงกัน');
    }
  }).catch(function(e){ spin(0); fail(e); });
}
function applyBoot(d){
  BOOT = d; if (d.me) ME = d.me;
  LBL = d.labels || LBL; WEB_APP_URL = d.webAppUrl || WEB_APP_URL;
  PTCEU_TARGET = d.ptceuTarget || 50; HIDE_LIC = !!d.hideLicense;
  var adm = ME && ME.role === 'admin';
  document.querySelectorAll('.admin-only').forEach(function(e){ e.classList.toggle('hide', !adm); });
  document.querySelectorAll('.thLic').forEach(function(e){ e.textContent = LBL.license; });
  document.querySelectorAll('.thScore').forEach(function(e){ e.textContent = LBL.score; });
  if (!MOD_DIRTY) renderSidebarMods(d.modules);
  paintHome(d);
  paintDock(ME);
