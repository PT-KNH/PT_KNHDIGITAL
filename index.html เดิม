function labelize(tbodyId){
  var tb = $(tbodyId); if (!tb) return;
  var tbl = tb.closest ? tb.closest('table') : tb.parentNode;
  var labels = Array.prototype.map.call(tbl ? tbl.querySelectorAll('thead th') : [], function(t){ return t.textContent.trim(); });
  Array.prototype.forEach.call(tb.rows, function(tr){
    if (tr.cells.length === 1 && tr.cells[0].colSpan > 1) return;
    Array.prototype.forEach.call(tr.cells, function(td, i){
      if (!td.hasAttribute('data-label')) td.setAttribute('data-label', labels[i] || '');
    });
  });
