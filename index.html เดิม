      var st = p.days < 0 ? '❌ หมดอายุแล้ว ' + Math.abs(p.days) + ' วัน' : p.days === 0 ? '❗ หมดอายุวันนี้' : '⚠️ เหลือ ' + p.days + ' วัน';
      L.push((i + 1) + '. ' + p.fullName);
      L.push('   ' + (HIDE_LIC ? '' : LBL.license + ': ' + (p.licenseNo || '-') + ' | ') + LBL.score + ': ' + (p.licenseScore || 0) + '/' + PTCEU_TARGET);
      L.push('   หมดอายุ: ' + thDate2(p.licenseExpire) + ' | ' + st);
    });
  } else L.push('✅ ไม่พบรายการใบประกอบวิชาชีพใกล้หมดอายุภายใน 180 วัน');
  var roster = (BOOT && BOOT.expiry && BOOT.expiry.roster) || [];
  if (roster.length){
    L.push('', '👥 สถานะนักกายภาพบำบัดทุกคน (' + roster.length + ' คน · เป้าหมาย ' + LBL.score + ' ' + PTCEU_TARGET + ' คะแนน)', '');
    roster.forEach(function(p, i){
      L.push((i + 1) + '. ' + p.fullName);
      L.push('   ⭐ ' + LBL.score + ': ' + p.licenseScore + '/' + PTCEU_TARGET + (p.need > 0 ? ' (ขาดอีก ' + p.need + ')' : ' ✅ ครบแล้ว'));
      L.push('   📅 หมดอายุ: ' + thDate2(p.licenseExpire) + ' | ' + daysTxt(p.days));
    });
