function setKpiFilter(f){
  KPI_FILTER = f;
  document.querySelectorAll('#kpiPills .pill').forEach(function(b){ b.classList.toggle('on', b.getAttribute('data-f') === f); });
  renderKpiTable();
}
function isMyKpi(k){
  if (!ME) return false;
  var own = String(k.owner || '').toLowerCase();
  if (!own || own === '-') return false;
  var fn = String(ME.fullName || '').trim().toLowerCase();
  var first = fn.split(/\s+/)[0] || '';
  return (fn && own.indexOf(fn) > -1) || (first.length > 2 && own.indexOf(first) > -1) || own.indexOf(String(ME.username || '').toLowerCase()) > -1 || own.indexOf('ทุกคน') > -1;
}
function trendBadgeHtml(k){
  if (!k.hasData || k.delta === null || k.delta === undefined) return '';
  if (k.delta === 0) return '<span class="trend neutral" title="เท่ากับเดือนก่อน">▬ 0</span>';
  var sign = k.delta > 0 ? '▲ +' + k.delta : '▼ ' + k.delta;
  var cls = k.trendGood === true ? 'good' : k.trendGood === false ? 'bad' : 'neutral';
  return '<span class="trend ' + cls + '" title="เทียบเดือนก่อนหน้า">' + esc(sign) + '</span>';
}
function loadKPI(){
  var y = $('kpiYear').value || '';
  var req = ++KPI_REQ;
  skel('kpiBody', 7, 6);
  api('listKPI', TOKEN, y).then(function(r){
    if (req !== KPI_REQ) return;
    KPI_CACHE = r; fillYears(r.years, r.year);
    var s = r.summary || {};
    $('kpiHeadStat').innerHTML = statCard('ตัวชี้วัดทั้งหมด', s.total || 0, '#0ea5e9', '', "setKpiFilter('all')") +
      statCard('ผ่านเกณฑ์', s.pass || 0, '#10b981', '', "setKpiFilter('pass')") +
      statCard('ไม่ผ่านเกณฑ์', s.fail || 0, '#ef4444', '', "setKpiFilter('fail')") +
      statCard('รอรายงานผล', s.waiting || 0, '#94a3b8', '', "setKpiFilter('wait')") +
      statCard('ความสำเร็จเฉลี่ย', (s.avg || 0) + '%', '#10b981');
    renderKpiTable();
  }).catch(function(e){ if (req === KPI_REQ) fail(e); });
}
function renderKpiTable(){
  if (!KPI_CACHE) return;
  document.querySelectorAll('#kpiPills .pill').forEach(function(b){ b.classList.toggle('on', b.getAttribute('data-f') === KPI_FILTER); });
  var q = ($('kSearch').value || '').toLowerCase().trim();
  var adm = ME && ME.role === 'admin';
  var list = (KPI_CACHE.rows || []).filter(function(k){
    if (KPI_FILTER === 'mine' && !isMyKpi(k)) return false;
    if (KPI_FILTER === 'fail' && k.pass !== false) return false;
    if (KPI_FILTER === 'pass' && k.pass !== true) return false;
    if (KPI_FILTER === 'wait' && k.hasData) return false;
    if (q && (k.code + ' ' + k.name + ' ' + k.owner + ' ' + k.group).toLowerCase().indexOf(q) === -1) return false;
    return true;
  });
  var html = '', lastG = null;
  list.forEach(function(k){
    if (k.group !== lastG){ lastG = k.group; html += '<tr class="grp"><td colspan="7">' + esc(k.group) + '</td></tr>'; }
    var col = k.pass === null ? (k.hasData ? '#f59e0b' : '#cbd5e1') : (k.pass ? '#10b981' : '#ef4444');
    var bg = k.pass === null ? (k.hasData ? '<span class="bg amber">ไม่มีเกณฑ์</span>' : '<span class="bg gray">รอข้อมูล</span>') : (k.pass ? '<span class="bg green">ผ่าน</span>' : '<span class="bg red">ไม่ผ่าน</span>');
    var ytdCell = k.hasData
      ? '<span><b>' + esc(k.ytd) + '</b>' + trendBadgeHtml(k) + (k.lastMonth ? '<div><small class="muted">ล่าสุด: ' + esc(k.lastMonth) + '</small></div>' : '') + '</span>'
      : '<span class="muted">–</span>';
    html += '<tr><td><b>' + esc(k.code) + '</b></td><td><span>' + esc(k.name) + (k.note ? '<div><small class="muted">💬 ' + esc(k.note) + '</small></div>' : '') + '</span></td><td class="ct">' + esc(k.target) + '</td>' +
      '<td class="rt">' + ytdCell + '</td>' +
      '<td><div class="bar"><i style="width:' + Math.min(k.pct,100) + '%;background:' + col + '"></i></div><small>' + (k.hasData ? k.pct + '% ' : '') + bg + '</small></td>' +
      '<td>' + esc(k.owner) + '</td><td><span><button class="btn sm" onclick="viewKpi(\'' + esc(k.id) + '\')">📈 กราฟ</button> ' +
      '<button class="btn sm ' + (adm ? '' : 'primary') + '" onclick="openKpiForm(\'' + esc(k.id) + '\')">' + (adm ? 'แก้ไข' : '📝 บันทึกผล') + '</button> ' +
      (adm ? '<button class="btn sm danger" onclick="delKPI(\'' + esc(k.id) + '\')">ลบ</button>' : '') + '</span></td></tr>';
  });
  $('kpiBody').innerHTML = html || '<tr><td colspan="7" class="ct muted">ไม่พบตัวชี้วัดตามเงื่อนไขที่เลือก</td></tr>';
  labelize('kpiBody');
}
function exportKpiCsv(){
