  L.push('');
  if (WEB_APP_URL){ L.push('🔗 เข้าสู่ระบบ PT Center:'); L.push(WEB_APP_URL); L.push(''); }
  L.push('— ระบบ PT Digital Center —');
  return L.join('\n');
