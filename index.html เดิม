  var rows = KPI_CACHE.rows.map(function(k){
    var st = k.pass === null ? (k.hasData ? 'ไม่มีเกณฑ์' : 'รอข้อมูล') : (k.pass ? 'ผ่าน' : 'ไม่ผ่าน');
    return [k.year, k.code, k.group, k.name, k.target, k.owner].concat(k.months).concat([k.ytd, st, k.note]);
  });
