function saveKpiForm(id){
  var months = []; for (var i = 0; i < 12; i++) months.push($('km' + i).value);
  var d = { id:id, year:$('kYear').value.trim(), code:$('kCode').value.trim(), target:$('kTarget').value.trim(), name:$('kName').value.trim(),
    group:$('kGroup').value.trim(), owner:$('kOwner').value.trim(), freq:$('kFreq').value.trim(), formula:$('kFormula').value.trim(),
    ytdMode:$('kYtd').value, note:$('kNote').value.trim(), months:months };
  if (ME && ME.role === 'admin'){
    if (!d.name) return toast('กรุณากรอกชื่อตัวชี้วัด');
    if (!/^25\d{2}$/.test(d.year)) return toast('ปีงบประมาณไม่ถูกต้อง (เช่น 2570)');
  }
  spin(1);
  api('saveKPI', TOKEN, d).then(function(r){
    spin(0); toast(r.msg);
    if (!r.ok) return;
    closeModal(true);
    var sel = $('kpiYear');
    if (sel && d.year){
      var exists = Array.prototype.some.call(sel.options, function(o){ return o.value === d.year; });
      if (!exists){ var op = document.createElement('option'); op.value = d.year; op.textContent = 'ปีงบประมาณ ' + d.year; sel.appendChild(op); }
      sel.value = d.year;
    }
    KPI_CACHE = null; loadKPI(); loadBoot();
  }).catch(fail);
}
function delKPI(id){
  var k = findKpi(id); if (!k) return;
  if (!confirm('ลบตัวชี้วัด "' + k.code + ' ' + k.name + '" ?')) return;
  spin(1);
  api('deleteKPI', TOKEN, id).then(function(r){ spin(0); toast(r.msg); KPI_CACHE = null; loadKPI(); loadBoot(); }).catch(fail);
}

