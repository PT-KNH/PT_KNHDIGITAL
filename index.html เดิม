function api(name){
  var args = Array.prototype.slice.call(arguments, 1);
  if (IS_GAS){
    return new Promise(function(resolve, reject){
      var r = google.script.run.withSuccessHandler(resolve).withFailureHandler(function(e){
        if (String(e && e.message).indexOf('SESSION_EXPIRED') > -1) sessionExpired();
        reject(e);
      });
      if (typeof r[name] !== 'function') return reject(new Error('ไม่พบฟังก์ชัน ' + name + ' บนเซิร์ฟเวอร์'));
      r[name].apply(r, args);
    });
  }
  return new Promise(function(resolve, reject){
    var url = getGasUrl();
    if (!url){
      var box = $('apiCfgBox'); if (box) box.classList.remove('hide');
      return reject(new Error('กรุณาตั้งค่าลิงก์ Web App (/exec) ก่อนใช้งานบน GitHub Pages'));
    }
    var ctrl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
    var timer = setTimeout(function(){ if (ctrl) ctrl.abort(); }, API_TIMEOUT_MS);
    fetch(url, {
      method:'POST',
      headers:{ 'Content-Type':'text/plain;charset=utf-8' },
      body:JSON.stringify({ rpc:name, args:args }),
      redirect:'follow',
      signal: ctrl ? ctrl.signal : undefined
    }).then(function(res){
      if (!res.ok) throw new Error('เซิร์ฟเวอร์ตอบกลับ HTTP ' + res.status);
      return res.text();
    }).then(function(txt){
      clearTimeout(timer);
      var j;
      try { j = JSON.parse(txt); }
      catch(e){ throw new Error('เซิร์ฟเวอร์ไม่ได้ตอบกลับเป็น JSON — ตรวจสอบว่า Deploy แบบ "Anyone" และใช้ลิงก์ /exec ของเวอร์ชันล่าสุด'); }
      if (!j || j.__rpc_ok !== true){
        var errMsg = (j && j.error) || 'การเชื่อมต่อขัดข้อง';
        if (String(errMsg).indexOf('SESSION_EXPIRED') > -1) sessionExpired();
        throw new Error(errMsg);
      }
      resolve(j.data);
    }).catch(function(err){
      clearTimeout(timer);
      if (err && err.name === 'AbortError') err = new Error('เซิร์ฟเวอร์ตอบช้าเกินไป กรุณาลองใหม่อีกครั้ง');
      else if (err && /Failed to fetch|NetworkError|Load failed/i.test(String(err.message))) err = new Error('เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ ตรวจสอบอินเทอร์เน็ต');
      reject(err);
    });
  });
}
function fail(e){ spin(0); if (String(e && e.message).indexOf('SESSION_EXPIRED') > -1) return; toast((e && e.message) || 'เกิดข้อผิดพลาดในการเชื่อมต่อ'); }
function sessionExpired(){
  if (EXPIRED_HANDLED) return; EXPIRED_HANDLED = true;
  FORM_DIRTY = false; MOD_DIRTY = false;
  localStorage.removeItem('pt_token');
  localStorage.removeItem('pt_boot_cache');
